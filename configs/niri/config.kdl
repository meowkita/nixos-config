input {
    keyboard {
        numlock
        repeat-rate 35
        repeat-delay 200
        track-layout "global"

        xkb {
            layout "us,ru"
            options "grp:win_space_toggle"
        }
    }

    touchpad {
        tap
    }

    mouse {
        accel-profile "flat"
    }
}

cursor {
    xcursor-size 24
    xcursor-theme "Bibata-Modern-Ice"
    hide-after-inactive-ms 1000
    hide-when-typing
}

output "eDP-1" {
    mode "3200x2000@120.000"
    scale 1.75
    transform "normal"
    position x=1000 y=0
}

overview {
    zoom 0.4
    backdrop-color "#13262dff"
}

gestures {
    hot-corners {
        off
    }
}

layout {
    gaps 8
    always-center-single-column
    center-focused-column "never"
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    preset-window-heights {
        proportion 1.0
    }

    default-column-width {
        proportion 0.5;
    }

    focus-ring {
        off
    }

    border {
        on
        width 2
        active-gradient from="#ff7a8aff" to="#e6e878ff" angle=45
        inactive-gradient from="#22313acc" to="#16242ccc" angle=45
        urgent-color "#ff3b6b"
    }

    shadow {
        on
        spread 4
        softness 30
        offset x=0 y=4
        color "#00000070"
    }
}

workspace "main"
workspace "chats"
workspace "notes"
workspace "media"
workspace "recording"

window-rule {
    clip-to-geometry true
    geometry-corner-radius 8
    draw-border-with-background false
}

window-rule {
    match app-id="zen"
    default-column-width { proportion 0.66666; }
}

window-rule {
    match app-id="codium"
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id="org.telegram.desktop"
    open-on-workspace "chats"
    default-column-width { proportion 0.66666; }
}

window-rule {
    match app-id="vesktop"
    open-on-workspace "chats"
    default-column-width { proportion 0.66666; }
}

window-rule {
    match app-id="obsidian"
    open-on-workspace "notes"
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id="spotify"
    open-on-workspace "media"
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id="com.obsproject.Studio"
    open-on-workspace "recording"
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id="blueman-manager"
    open-floating true
    default-column-width { fixed 400; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="pavucontrol"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 800; }
}

window-rule {
    match app-id="nm-connection-editor"
    open-floating true
    default-column-width { fixed 400; }
    default-window-height { fixed 600; }
}

binds {
    Mod+A repeat=false { spawn "fuzzel"; }
    Mod+L repeat=false { spawn "swaylock"; }
    Mod+Q repeat=false { spawn "alacritty"; }
    Mod+Escape         { spawn-sh "~/.config/fuzzel/powermenu.sh"; }
    Mod+Shift+9        { spawn-sh "killall -r waybar; waybar"; }
    Mod+Shift+0        { spawn-sh "killall -r swaybg; swaybg -i ~/.config/swaybg/nms.jpg -m fill"; }

    Mod+Tab repeat=false { toggle-overview; }
    
    Mod+C       repeat=false { close-window; }
    Mod+R       repeat=false { switch-preset-column-width; }
    Mod+F       repeat=false { maximize-column; }
    Mod+Shift+F repeat=false { fullscreen-window; }
    Mod+Shift+V repeat=false { toggle-window-floating; }

    Mod+Left  repeat=false { focus-column-left; }
    Mod+Right repeat=false { focus-column-right; }
    Mod+Up    repeat=false { focus-window-or-workspace-up; }
    Mod+Down  repeat=false { focus-window-or-workspace-down; }

    Mod+Shift+Left  repeat=false { move-column-left; }
    Mod+Shift+Right repeat=false { move-column-right; }
    Mod+Shift+Up    repeat=false { move-window-up-or-to-workspace-up; }
    Mod+Shift+Down  repeat=false { move-window-down-or-to-workspace-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }

    XF86MonBrightnessUp   { spawn-sh "brightnessctl --class=backlight set +10%"; }
    XF86MonBrightnessDown { spawn-sh "brightnessctl --class=backlight set 10%-"; }

    XF86AudioRaiseVolume { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+"; }
    XF86AudioLowerVolume { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    XF86AudioMute        { spawn-sh "wpctl set-mute   @DEFAULT_AUDIO_SINK@ toggle"; }

    Mod+Shift+S     repeat=false { screenshot; }
    Ctrl+Alt+Delete repeat=false { quit; }
    Mod+Shift+Slash repeat=false { show-hotkey-overlay; }
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

spawn-sh-at-startup "Telegram"
spawn-sh-at-startup "vesktop"
spawn-sh-at-startup "obsidian"
spawn-sh-at-startup "spotify"
spawn-sh-at-startup "obs"

spawn-at-startup "mako"
spawn-at-startup "waybar"
spawn-at-startup "nm-applet"
spawn-at-startup "blueman-applet"
spawn-sh-at-startup "swaybg -i ~/.config/swaybg/nms.jpg -m fill"
spawn-sh-at-startup "swayidle -w timeout 300 swaylock -f timeout 600 niri msg action power-off-monitors resume niri msg action power-on-monitors before-sleep swaylock -f"
spawn-sh-at-startup "gnome-keyring-daemon --start --components=secrets"
